@@ -3,6 +3,102 @@
 use crate::{ControlStore, StoreError};
 use std::time::{Duration, Instant};
 
+#[test]
+fn hot_scope_statement_is_retained_but_cross_connection_revocation_is_live() {
+    let dir = tempfile::tempdir().unwrap();
+    let path = dir.path().join("control.sqlite");
+    let mut reader = ControlStore::open(&path).unwrap();
+    let scope = reader
+        .register_scope(
+            &diskgraph_core::Locator {
+                kind: diskgraph_core::LocatorKind::NativePath,
+                raw_b64: "L2ZpeHR1cmU=".into(),
+                display: "/fixture".into(),
+            },
+            None,
+        )
+        .unwrap();
+    let mut writer = ControlStore::open(&path).unwrap();
+    reader.connection.flush_prepared_statement_cache();
+    let statement_count = || {
+        let mut count = 0;
+        // 只观察当前测试连接的编译语句，不移动或释放原 statement。
+        unsafe {
+            let db = reader.connection.handle();
+            let mut statement = rusqlite::ffi::sqlite3_next_stmt(db, std::ptr::null_mut());
+            while !statement.is_null() {
+                count += 1;
+                statement = rusqlite::ffi::sqlite3_next_stmt(db, statement);
+            }
+        }
+        count
+    };
+    assert_eq!(statement_count(), 0);
+    assert!(!reader.scope_revoked(&scope).unwrap());
+    assert_eq!(
+        statement_count(),
+        1,
+        "hot scope SQL should remain compiled, without retaining rows"
+    );
+    writer.revoke_scope(&scope).unwrap();
+    assert!(
+        reader.scope_revoked(&scope).unwrap(),
+        "compiled statements must observe independent commits"
+    );
+    assert_eq!(statement_count(), 1);
+}
+
+#[test]
+#[ignore = "release microbenchmark only; not native platform acceptance"]
+fn cached_scope_query_costs() {
+    let mut store = ControlStore::open_in_memory().unwrap();
+    let scope = store
+        .register_scope(
+            &diskgraph_core::Locator {
+                kind: diskgraph_core::LocatorKind::NativePath,
+                raw_b64: "L2ZpeHR1cmU=".into(),
+                display: "/fixture".into(),
+            },
+            None,
+        )
+        .unwrap();
+    let mut cached = Vec::new();
+    let mut compiled = Vec::new();
+    for round in 0..1000 {
+        for offset in 0..2 {
+            let reuse = (round + offset) % 2 == 0;
+            let started = Instant::now();
+            let revoked = if reuse {
+                store.scope_revoked(&scope).unwrap()
+            } else {
+                store
+                    .connection
+                    .query_row(
+                        "SELECT revoked FROM scopes WHERE scope_id=?1",
+                        [scope.as_str()],
+                        |row| Ok(row.get::<_, i64>(0)? != 0),
+                    )
+                    .unwrap()
+            };
+            let elapsed = started.elapsed().as_secs_f64() * 1000.0;
+            assert!(!revoked);
+            if reuse {
+                cached.push(elapsed);
+            } else {
+                compiled.push(elapsed);
+            }
+        }
+    }
+    cached.sort_by(f64::total_cmp);
+    compiled.sort_by(f64::total_cmp);
+    println!(
+        "{}",
+        serde_json::json!({"fixture":"in-memory scope SQL alternating order", "production_qualification":false,
+        "samples_per_variant":1000,"cached":{"p50_ms":cached[499],"p95_ms":cached[949]},
+        "compiled_each_time":{"p50_ms":compiled[499],"p95_ms":compiled[949]}})
+    );
+}
+
 fn configured_store() -> ControlStore {
     let store = ControlStore::open_in_memory().unwrap();
     store
