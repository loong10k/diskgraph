@@ -6,6 +6,45 @@ use crate::windows_native_scan_root::WindowsNativeScanRoot;
 
 use super::{node, root, settings};
 
+#[test]
+fn combined_root_capture_keeps_full_state_with_fewer_native_boundaries() {
+    use crate::windows_file_state::WindowsFileState;
+    use crate::windows_native_open::{open_child, open_drive};
+    use std::cell::Cell;
+    let workspace = tempfile::tempdir().unwrap();
+    let root = root(&workspace);
+    let plan = crate::windows_path_plan::WindowsPathPlan::for_root(&root).unwrap();
+    let mut directory = open_drive(&plan.drive_root).unwrap();
+    for name in &plan.components {
+        directory = open_child(&directory, name, true).unwrap();
+    }
+    // 真正打开的同一句柄应保留全部字段，包括目录内容变化后的原生时间。
+    for index in 0..3 {
+        std::fs::write(root.join(format!("change-{index}")), b"change").unwrap();
+        let ordinary_checks = Cell::new(0);
+        let ordinary = WindowsFileState::capture_checked(&directory, &|| {
+            ordinary_checks.set(ordinary_checks.get() + 1);
+            Ok(())
+        })
+        .unwrap()
+        .unwrap();
+        let combined_checks = Cell::new(0);
+        let combined = WindowsFileState::capture_root_checked(&directory, &|| {
+            combined_checks.set(combined_checks.get() + 1);
+            Ok(())
+        })
+        .unwrap()
+        .unwrap();
+        assert_eq!(ordinary, combined);
+        assert!(
+            combined_checks.get() < ordinary_checks.get(),
+            "combined={} ordinary={}",
+            combined_checks.get(),
+            ordinary_checks.get()
+        );
+    }
+}
