+fn root_prefix_complete(status: i32, returned: usize) -> bool {
+    matches!(status as u32, 0 | 0x8000_0005)
+        && returned >= std::mem::offset_of!(FILE_ALL_INFORMATION, InternalInformation)
+        && returned <= std::mem::size_of::<FILE_ALL_INFORMATION>()
+}
