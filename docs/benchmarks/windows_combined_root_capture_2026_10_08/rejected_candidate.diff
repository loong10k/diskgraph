+#[cfg(test)]
+mod tests {
+    use super::{FILE_ALL_INFORMATION, root_prefix_complete};
+
+    #[test]
+    fn root_query_never_accepts_missing_prefix_or_other_status() {
+        let minimum = std::mem::offset_of!(FILE_ALL_INFORMATION, InternalInformation);
+        let size = std::mem::size_of::<FILE_ALL_INFORMATION>();
+        for status in [0, 0x8000_0005_u32 as i32] {
+            assert!(root_prefix_complete(status, minimum));
+            assert!(root_prefix_complete(status, size));
+            for returned in [0, minimum - 1, size + 1, usize::MAX] {
+                assert!(!root_prefix_complete(status, returned));
+            }
+        }
+        for status in [0x103, 0x8000_0006_u32 as i32, 0xc000_0004_u32 as i32, -1] {
+            assert!(!root_prefix_complete(status, size));
+        }
+    }
